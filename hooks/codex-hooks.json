{
  "description": "Fast Forgeward feedback for Codex. The standalone Git pre-push hook remains the enforcement boundary.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/forgeward-gate-check.sh prompt-submit",
            "commandWindows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10,
            "statusMessage": "Checking Forgeward gate marker"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/forgeward-gate-check.sh pretooluse",
            "commandWindows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10,
            "statusMessage": "Checking Forgeward publish guardrail"
          }
        ]
      }
    ]
  }
}
